# Supabase server-only connection. Never prefix secret values with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Prefer PBKDF2 on Cloudflare. bcrypt remains available as a legacy fallback.
ADMIN_PASSWORD_PBKDF2=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional local preview. Keep false in production.
DEMO_MODE=false
