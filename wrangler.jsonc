{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prompt-homework-aicrew",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.ts",
  "triggers": { "crons": ["* 0-13,23 * * *"] },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "vars": {
    "DEMO_MODE": "false"
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SECRET_KEY",
      "ADMIN_PASSWORD_PBKDF2",
      "ADMIN_PASSWORD_HASH",
      "ADMIN_SESSION_SECRET",
      "VAPID_PRIVATE_JWK",
      "VAPID_PUBLIC_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
